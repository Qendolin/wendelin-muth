{
  "name": "wendelin-muth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "deploy:hosting": "firebase deploy --only hosting:wendelin-muth",
    "prebuild": "deno run upload-images && deno run --allow-read --allow-write scripts/build-timestamp.ts",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "upload-images": "deno run --allow-read --allow-write --allow-net --allow-env --allow-sys --allow-ffi scripts/upload-images.ts"
  },
  "dependencies": {
    "firebase": "^12.11.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@nvl/sveltex": "^0.4.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22",
    "@unpic/core": "^1.0.3",
    "@unpic/placeholder": "^0.1.2",
    "@unpic/svelte": "^1.0.1",
    "blurhash": "^2.0.5",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.2",
    "firebase-admin": "^13.7.0",
    "globals": "^17.4.0",
    "magic-string": "^0.30.21",
    "mathjax-full": "^3.2.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-retext": "^6.0.1",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "sirv": "^3.0.2",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unpic": "^4.2.2",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0"
  }
}
