rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ───────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'gB9DEJyxjbQWI7cliTcDukRzD5l1';
    }

    // ── Comments ──────────────────────────────────────────────────────────

    match /comments/{commentId} {
      // Comments are public.
      allow read: if true;

      // NOTE: hasAll() only checks that the required keys are present, it does
      // not forbid extra fields. A malicious client could stuff additional
      // fields into a comment. Not exploitable today because the client only
      // reads back and renders known fields, but don't rely on this as a guard.
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        // Required fields must be present.
        && request.resource.data.keys().hasAll([
          'route_id', 'user_id', 'author', 'body', 'parent_id', 'created_date', 'modified_date'
        ])
        // Field types and length limits.
        && request.resource.data.route_id is string
        && request.resource.data.route_id.size() > 0
        && request.resource.data.route_id.size() <= 256
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 32
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        // parent_id must be a string or null.
        && (request.resource.data.parent_id == null || request.resource.data.parent_id is string);

      // Authors may only change body and modified_date.
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.user_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'modified_date'])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000);

      // Authors or admins may delete.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
    }

    // ── Users ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Users read their own doc; admins read any.
      allow read: if isAdmin() || request.auth.uid == userId;

      // Sign-up and name changes write the fully merged doc via
      // setDoc(..., { merge: true }), so create requires a well-formed doc.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['display_name', 'is_anonymous'])
        && request.resource.data.keys().hasOnly(['display_name', 'is_anonymous'])
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 32
        && request.resource.data.is_anonymous is bool;

      // update allows partial writes; per-field checks apply when the field
      // is present.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name', 'is_anonymous'])
        && (!('display_name' in request.resource.data)
          || (request.resource.data.display_name is string
            && request.resource.data.display_name.size() > 0
            && request.resource.data.display_name.size() <= 32))
        && (!('is_anonymous' in request.resource.data)
          || request.resource.data.is_anonymous is bool);

      allow delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────

    match /notifications/{userId}/inbox/{notifId} {
      // Per-user inbox; only the owner can read or delete.
      // Creates happen server-side via the Cloud Function (Admin SDK bypasses rules).
      allow read: if request.auth != null && request.auth.uid == userId;

      // Reading a notification deletes it (no update path exists).
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create: if false;
    }

    // ── Legacy website data (read-only) ───────────────────────────────────

    match /old-users/{user} {
      allow read: if true;
    }
    match /old-blog/{entry} {
      allow read: if true;
    }
    match /old-wall/{post} {
      allow read: if true;
    }
    match /old-comments/{comment} {
      allow read: if true;
    }
  }
}