<script lang="ts">
  import Link from '$lib/components/Link.svelte';
  import type { Thing, WithContext } from 'schema-dts';
  import type { PageProps } from '../../../.svelte-kit/types/src/routes/(app)/$types.d.ts';
  import type { Project } from '$lib/projects';
  import ProjectFeaturedEntry from '$lib/components/ProjectFeaturedEntry.svelte-old';
  import ProjectGridCard from '$lib/components/ProjectGridCard.svelte.old';

  function serializeSchema(thing: Thing | WithContext<Thing>) {
    return `<${'script'} type="application/ld+json" >${JSON.stringify(thing, null, 2)}</${'script'}>`;
  }

  const microdata = serializeSchema({
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://www.webindex.page/#myself',
    name: 'Wendelin Muth',
    givenName: 'Wendelin',
    familyName: 'Muth',
    email: 'wendelin.muth+website@gmail.com',
    url: 'https://www.webindex.page/',
    nationality: {
      '@type': 'Country',
      name: 'Austria'
    },
    affiliation: {
      '@type': 'EducationalOrganization',
      address: 'Karlsplatz 13, 1040 Wien',
      name: 'Technische Universität Wien',
      url: 'https://www.tuwien.at/'
    },
    jobTitle: 'Student',
    knowsLanguage: ['de', 'en']
  });

  let { data }: PageProps = $props();

  function toSortKey(p: Project): number {
    const { year, month = 0, day = 0 } = p.meta.startDate;
    return year * 10000 + month * 100 + day;
  }

  const sorted = $derived([...data.projects].sort((a, b) => toSortKey(b) - toSortKey(a)));
  const featured = $derived(sorted.filter((p) => p.meta.highlight));
  const rest = $derived(sorted.filter((p) => !p.meta.highlight));
</script>

<svelte:head>
  <!-- eslint-disable-next-line svelte/no-at-html-tags -->
  {@html microdata}
  <meta property="og:type" content="profile" />
  <meta property="og:title" content="Wendelin Muth - Homepage" />
  <meta property="og:url" content="https://www.webindex.page/" />
  <meta property="og:image" content="https://www.webindex.page/img/og-image.webp" />
  <meta property="og:image:type" content="image/webp" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:description" content="My personal website / blog. You should check it out!" />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://www.webindex.page/" />
  <meta property="twitter:title" content="Wendelin Muth - Homepage" />
  <meta property="twitter:description" content="My personal website / blog. You should check it out!" />
  <meta property="twitter:image" content="https://www.webindex.page/img/og-image.webp" />
  <meta property="profile:first_name" content="Wendelin" />
  <meta property="profile:last_name" content="Muth" />
  <meta name="description" content="My personal website / blog. You should check it out!" />
  <meta name="abstract" content="Hi, I'm Wendelin, I have a passion for software development and computer graphics." />
</svelte:head>

<h1>Welcome to my Website!</h1>
<hr style="width: 100%" />
<header>
  <article id="myself" itemscope itemtype="http://schema.org/Person" itemid="https://www.webindex.page/#myself">
    <header>
      <h2>About</h2>
    </header>
    <meta itemprop="name" content="Wendelin Muth" />
    <meta itemprop="url" content="https://www.webindex.page/" />

    <!-- TODO: -->

    <br />
    If you want to know more about me, you can check out my
    <Link href="https://github.com/Qendolin/">GitHub</Link>
    and
    <Link href="https://www.linkedin.com/in/wendelin-muth">LinkedIn</Link>.
    <br />
    If you want to get in touch, contact me via
    <Link target="_blank" rel="noreferrer noopener nofollow" href="mailto:wendelin.muth+website@gmail.com">wendelin.muth+website@gmail.com</Link>
    or Discord
    <Link target="_blank" rel="noreferrer noopener nofollow" href="https://discord.com/users/qendolin_">@qendolin_</Link>.
  </article>
</header>

<header class="mb-10 flex items-baseline justify-between border-b-[1.5px] border-current pb-3">
  <h1 class="page-title">Projects</h1>
  <span class="section-label">{data.projects.length} entries</span>
</header>

{#if featured.length > 0}
  <section class="mb-12">
    <p class="section-label mb-5">Featured</p>
    <ol class="m-0 list-none p-0">
      {#each featured as project, i}
        <ProjectFeaturedEntry {project} index={i} />
      {/each}
    </ol>
  </section>
{/if}

{#if rest.length > 0}
  <section>
    <p class="section-label mb-5">More work</p>
    <ol class="grid-mosaic">
      {#each rest as project}
        <ProjectGridCard {project} />
      {/each}
    </ol>
  </section>
{/if}

<style lang="postcss">
  @reference '$app.css';

  .page-title {
    @apply leading-none font-bold;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
  }

  .section-label {
    @apply m-0 uppercase opacity-45;
    letter-spacing: 0.15em;
  }

  /* gap-px + bg-current draws 1px grid lines between cards without
     needing explicit borders on each one. */
  .grid-mosaic {
    @apply m-0 grid list-none gap-px border border-transparent p-0;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
</style>
