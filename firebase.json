{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      "*.ts",
      "deno.json",
      "deno.lock",
      "tsconfig.json",
      ".git",
      "lib"
    ]
  },
  "hosting": {
    "predeploy": "deno run build",
    "site": "wendelin-muth",
    "public": "build",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/entry/:post*",
        "destination": "/blog/:post",
        "type": 301
      }
    ]
  }
}
